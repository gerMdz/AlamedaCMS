{% extends 'admin/bars.html.twig' %}

{% block title %}Reservante{% endblock %}

{% block contenpage %}
    <h2>Reservante</h2>

    <div class="table-responsive">
    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ reservante.id }}</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>{{ reservante.email }}</td>
            </tr>
            <tr>
                <th>Apellido</th>
                <td>{{ reservante.apellido }}</td>
            </tr>
            <tr>
                <th>Nombre</th>
                <td>{{ reservante.nombre }}</td>
            </tr>
            <tr>
                <th>Telefono</th>
                <td>{{ reservante.telefono }}</td>
            </tr>
            <tr>
                <th>IsPresente</th>
                <td>{{ reservante.isPresente ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>Documento</th>
                <td>{{ reservante.documento }}</td>
            </tr>
        </tbody>
    </table>
    </div>

    <a href="{{ path('reservante_index') }}" class="btn btn-sm btn-info btn-round">back to list</a>

    <a href="{{ path('reservante_edit', {'id': reservante.id}) }}">edit</a>

    {{ include('reservante/_delete_form.html.twig') }}
{% endblock %}
