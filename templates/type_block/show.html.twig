{% extends 'admin/bars.html.twig' %}

{% block title %}TypeBlock{% endblock %}

{% block contenpage %}
    <h2>TypeBlock</h2>

    <div class="table-responsive">
    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ type_block.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ type_block.name }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ type_block.description }}</td>
            </tr>
            <tr>
                <th>Identifier</th>
                <td>{{ type_block.identifier }}</td>
            </tr>
            <tr>
                <th>IsActive</th>
                <td>{{ type_block.isActive ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>Entity Relacionada</th>
                <td>{{ type_block.entity }}</td>
            </tr>
        </tbody>
    </table>
    </div>

    <a href="{{ path('type_block_index') }}" class="btn btn-sm btn-info btn-round">back to list</a>

    <a href="{{ path('type_block_edit', {'id': type_block.id}) }}">edit</a>

    {{ include('type_block/_delete_form.html.twig') }}
{% endblock %}
