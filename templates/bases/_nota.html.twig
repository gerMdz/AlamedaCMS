<!--suppress TwigHardcodedStringInspection -->
<style>
    .nota-mensaje .nota-style {
        border: 2px solid #9c27b0; /*borde: estilo y color*/
        padding: 10px 10px 10px 2em; /*tamaño del fondo*/
        border-radius: 30px 0 30px 0; /*ángulos de las 4 esquinas del borde/fondo*/
        margin-bottom: 1em; /*espacio debajo de la etiqueta */
        text-transform: uppercase;
    }

    .nota-mensaje :is(p.text-14-300, h3, h4.text-14-300, small, h5.text-izq, h4.text-izq) {
        color: #1b1e24;
        text-align: left !important;
    }

    .nota-mensaje .text-300 {
        font-weight: 300 !important;
    }

    .nota-mensaje .text-14 {
        font-size: 1.2em !important;
    }

    .nota-mensaje .text-centrado {
        text-align: center !important;
    }

    .nota-mensaje :is(h4.text-centrado, h5.text-centrado, h6.text-centrado) {
        text-align: center !important;

    }

    .nota-mensaje .texto-left {
        text-align: left !important;
    }

    .nota-mensaje .text-600 {
        font-weight: 600;
    }
</style>
<div class="nota-mensaje"{% if not conservarRespuestas|default(false) %} data-nota-version="{{ nota_version(contenido) }}"{% endif %}>
    {% if titulo|default(null) %}
        <h2 class="text-center">{{ titulo | striptags | html_decode }}</h2>
    {% endif %}
    {{ renderiza_nota(contenido) }}
</div>
{{ encore_entry_script_tags('nota_mensaje') }}
