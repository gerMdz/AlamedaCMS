{% extends 'admin/bars.html.twig' %}

{% block title %}PageIndex index{% endblock %}

{% block contenpage %}
    <h2>PageIndex index</h2>

    <div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for page_index in page_indices %}
            <tr>
                <td>{{ page_index.id }}</td>
                <td>{{ page_index.name }}</td>
                <td>
                    <a href="{{ path('page_index_show', {'id': page_index.id}) }}">show</a>
                    <a href="{{ path('page_index_edit', {'id': page_index.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    </div>

    <a href="{{ path('page_index_new') }}" class="btn btn-sm btn-primary btn-round">Create new</a>
{% endblock %}
