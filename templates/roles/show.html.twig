{% extends 'admin/bars.html.twig' %}

{% block title %}Roles{% endblock %}

{% block contenpage %}
    <h2>Roles</h2>

    <div class="table-responsive">
    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ role.id }}</td>
            </tr>
            <tr>
                <th>Nombre</th>
                <td>{{ role.nombre }}</td>
            </tr>
            <tr>
                <th>Identificador</th>
                <td>{{ role.identificador }}</td>
            </tr>
            <tr>
                <th>Descripción</th>
                <td>{{ role.descripcion }}</td>
            </tr>
        </tbody>
    </table>
    </div>

    <a href="{{ path('roles_list') }}" class="btn btn-sm btn-info btn-round">
        <i class="fa fa-backward"> </i> Volver al listado
    </a>

    <a href="{{ path('roles_edit', {'id': role.id}) }}">
        <i class="fa fa-edit"> </i> Editar
    </a>

    {{ include('roles/_delete_form.html.twig') }}
{% endblock %}
