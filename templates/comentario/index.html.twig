{% extends 'admin/bars.html.twig' %}

{% block title %}Comentario index{% endblock %}

{% block contenpage %}
    <h2>Comentario index</h2>

    <div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Contenido</th>
                <th>IsDeleted</th>
                <th>CreatedAt</th>
                <th>UpdatedAt</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for comentario in comentarios %}
            <tr>
                <td>{{ comentario.id }}</td>
                <td>{{ comentario.contenido }}</td>
                <td>{{ comentario.isDeleted ? 'Yes' : 'No' }}</td>
                <td>{{ comentario.createdAt ? comentario.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ comentario.updatedAt ? comentario.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('comentario_show', {'id': comentario.id}) }}">show</a>
                    <a href="{{ path('comentario_edit', {'id': comentario.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    </div>

    <a href="{{ path('comentario_new') }}" class="btn btn-sm btn-primary btn-round">Create new</a>
{% endblock %}
